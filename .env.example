# TrendHub ortam değişkenleri
# Bu dosyayı `.env` olarak kopyalayıp değerleri doldurun. `.env` ASLA commit edilmez.

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_DB=trendhub
POSTGRES_USER=trendhub
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://trendhub:CHANGE_ME@db:5432/trendhub

# --- Uygulama -----------------------------------------------------------------
APP_ENV=production
# Rastgele uzun bir değer (ör. `openssl rand -hex 32`). Şu an oturum belirteçleri
# rastgele üretilip DB'de hash'lendiği için zorunlu değil; ileride imzalama için ayrılmıştır.
APP_SECRET=CHANGE_ME

# İlk yönetici hesabı: yalnızca kullanıcı tablosu BOŞSA oluşturulur.
# Parola en az 12 karakter olmalı. İlk girişten sonra panelden değiştirin.
ADMIN_USER=admin
ADMIN_PASSWORD=CHANGE_ME

# Oturum çerezi yalnızca HTTPS üzerinden gönderilsin (önerilen: true).
# Panel şimdilik düz HTTP (ör. http://sunucu:8081) üzerinden açılıyorsa giriş
# yapılabilmesi için false yapılmalıdır; bu durumda HTTPS'e geçiş önerilir.
COOKIE_SECURE=true
SESSION_TTL_HOURS=12

# --- Worker -------------------------------------------------------------------
SYNC_INTERVAL_MINUTES=15
# Pazaryerine YAZMA (stok/fiyat/statü) işlemleri. Canlı Trendyol -> Çanta Bayim
# otomasyonuyla çakışmamak için KAPALI kalmalı.
CONNECTOR_WRITE_ENABLED=false

# --- Trendyol (boşsa entegrasyon "Bağlı değil" görünür) ------------------------
TRENDYOL_SELLER_ID=
TRENDYOL_API_KEY=
TRENDYOL_API_SECRET=
# TRENDYOL_BASE_URL=https://apigw.trendyol.com
# TRENDYOL_RATE_PER_MINUTE=60

# --- Hepsiburada (senkronizasyon henüz uygulanmadı) ---------------------------
HEPSIBURADA_MERCHANT_ID=
HEPSIBURADA_USERNAME=
HEPSIBURADA_PASSWORD=

# --- Amazon.com.tr SP-API (senkronizasyon henüz uygulanmadı) -----------------
AMAZON_SP_SELLER_ID=
AMAZON_SP_CLIENT_ID=
AMAZON_SP_CLIENT_SECRET=
AMAZON_SP_REFRESH_TOKEN=
# AMAZON_SP_MARKETPLACE_ID=A33AVAJ2PDY3EV
