# TrendHub ortam değişkenleri
# Bu dosyayı `.env` olarak kopyalayıp değerleri doldurun. `.env` ASLA commit edilmez.

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_DB=trendhub
POSTGRES_USER=trendhub
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://trendhub:CHANGE_ME@db:5432/trendhub

# --- Uygulama -----------------------------------------------------------------
APP_ENV=production
# Rastgele uzun bir değer (ör. `openssl rand -hex 32`, en az 16 karakter). Tedarikçi kaynak
# adresleri (URL token içerebilir) ve tedarikçi şifreleri DB'de bu anahtardan türetilen
# anahtarla ŞİFRELİ saklanır. deploy/deploy.sh boşsa/CHANGE_ME ise otomatik üretir.
# DİKKAT: Sonradan değiştirilirse kayıtlı tedarikçi şifreleri çözülemez, yeniden girilmesi gerekir.
APP_SECRET=CHANGE_ME

# İlk yönetici hesabı: ÖNERİLEN yöntem `./deploy/create-admin.sh` (parola etkileşimli
# sorulur; hiçbir dosyaya, shell geçmişine veya loga yazılmaz). ADMIN_PASSWORD'ü boş bırakın.
# Doldurulursa: yalnızca kullanıcı tablosu BOŞSA ve parola en az 12 karakterse API açılışında
# bu değerlerle admin oluşturulur.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Panelin yayınlanacağı port (8081 doluysa deploy/deploy.sh 8082-8099 arasından boş bir port
# seçip buraya yazar)
TRENDHUB_HTTP_PORT=8081

# Oturum çerezinin Secure bayrağı:
#   auto  (önerilen) HTTPS ile açılınca Secure, düz HTTP'de (ör. http://sunucu:8081) değil
#   true  her zaman Secure; nginx ÖNÜNDE ayrı bir TLS sonlandırıcı (Caddy/Traefik vb.) varsa bunu kullanın
#   false hiçbir zaman Secure değil (önerilmez)
COOKIE_SECURE=auto
SESSION_TTL_HOURS=12

# --- Worker -------------------------------------------------------------------
# Sipariş senkron aralığı. Ayrıca: günlük 30 günlük derin tarama (Trendyol en fazla 1 ay
# geriye izin verir), saatlik bağlantı testi (yalnızca bilgisi tanımlı pazaryerleri için).
SYNC_INTERVAL_MINUTES=15
# Başarısız iş kaç kez yeniden denensin (üstel geri çekilme ile)
JOB_MAX_ATTEMPTS=6
# Kuyruk boşken bekleme süresi (sn)
WORKER_POLL_SECONDS=5
# Pazaryerine YAZMA (stok/fiyat/statü) işlemleri. Canlı Trendyol -> Çanta Bayim
# otomasyonuyla çakışmamak için KAPALI kalmalı.
CONNECTOR_WRITE_ENABLED=false

# --- Trendyol (boşsa entegrasyon "Bağlı değil" görünür) ------------------------
TRENDYOL_SELLER_ID=
TRENDYOL_API_KEY=
TRENDYOL_API_SECRET=
# TRENDYOL_BASE_URL=https://apigw.trendyol.com
# TRENDYOL_RATE_PER_MINUTE=60
# Ürün/ilan okuma: Trendyol Ürün V1 servisi kapatılıyor, V2 şeması doğrulanmadı.
# Doğrulanana kadar KAPALI kalmalı (açılırsa yine yalnızca GET yapar).
TRENDYOL_LISTINGS_ENABLED=false

# --- Hepsiburada (salt okunur sipariş/paket senkronu; boşsa "Bağlı değil") ------
# HMS panel → Hesabım → Entegrasyon Bilgileri. Basic auth kullanıcı adı/şifresi ve Merchant ID.
HEPSIBURADA_MERCHANT_ID=
HEPSIBURADA_USERNAME=
HEPSIBURADA_PASSWORD=
# Zorunlu User-Agent başlığı (boşsa kullanıcı adı gönderilir, ör. firma_dev)
# HEPSIBURADA_USER_AGENT=
# HEPSIBURADA_BASE_URL=https://oms-external.hepsiburada.com
# HEPSIBURADA_LISTING_BASE_URL=https://listing-external.hepsiburada.com
# İlan okuma: yanıt şeması doğrulanmadı, KAPALI kalmalı (açılsa da yalnızca GET yapar)
HEPSIBURADA_LISTINGS_ENABLED=false

# --- Amazon.com.tr SP-API (salt okunur sipariş senkronizasyonu) ---------------
AMAZON_SP_SELLER_ID=
AMAZON_SP_CLIENT_ID=
AMAZON_SP_CLIENT_SECRET=
AMAZON_SP_REFRESH_TOKEN=
# AMAZON_SP_MARKETPLACE_ID=A33AVAJ2PDY3EV
# AMAZON_SP_ENDPOINT=https://sellingpartnerapi-eu.amazon.com

# --- Tedarikçiler (XML / API / CSV) -------------------------------------------
# Tedarikçiler panelden eklenir (Tedarikçiler → Yeni Tedarikçi Ekle). Şifre/token'lar panelden
# girilip şifreli saklanabilir VEYA burada SUPPLIER_ ile başlayan bir değişkende tutulup panelde
# yalnızca adı verilir (ör. SUPPLIER_ACME_TOKEN). Başka adlar okunmaz.
# SUPPLIER_ACME_TOKEN=
# Tedarikçi dosyası/beslemesi en fazla (MB)
# SUPPLIER_MAX_FEED_MB=50
# İç ağ adreslerine (localhost, 10.x, 192.168.x, docker servisleri) istek güvenlik için
# ENGELLİDİR. Tedarikçi gerçekten iç ağdaysa true yapın.
# SUPPLIER_ALLOW_PRIVATE_URLS=false

# --- Trendçantanız web mağazası (storefront) ---------------------------------
# Mağazanın yayınlanacağı port (nginx; önüne HTTPS sonlandırıcı koyun, ör. Caddy/Traefik/certbot)
TRENDCANTANIZ_HTTP_PORT=8090
# Kanonik adres: canonical, sitemap, OpenGraph, ödeme dönüş adresleri ve e-posta bağlantıları bu adresi kullanır.
# Canlıda DOLDURUN (HTTPS hazır olunca): STOREFRONT_BASE_URL=https://trendcantaniz.com
STOREFRONT_BASE_URL=
# Kartla ödeme sağlayıcısı: boş (kapalı) | paytr | iyzico. Seçilen sağlayıcının anahtarlarının TAMAMI
# doluysa kart seçeneği görünür; aksi halde gösterilmez. Anahtarlar yalnızca bu dosyada tutulur.
STOREFRONT_PAYMENT_PROVIDER=
# PayTR iFrame API (STOREFRONT_PAYMENT_PROVIDER=paytr). PayTR mağaza panelinde Bildirim URL:
#   https://trendcantaniz.com/odeme/geri-donus/paytr
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
# true: yalnızca test kartları kabul edilir. Canlıda false.
PAYTR_TEST_MODE=false
# iyzico Ödeme Formu (STOREFRONT_PAYMENT_PROVIDER=iyzico). Sandbox: https://sandbox-api.iyzipay.com
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://api.iyzipay.com

# Sipariş e-postaları ve müşteri şifre sıfırlama (SMTP_HOST boşsa e-posta gönderilmez)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_SSL=false
# Yeni web siparişinde mağaza sahibine e-posta (virgülle ayrılmış; boş = kapalı)
STOREFRONT_ORDER_ALERT_EMAILS=
# SMS: boş = kapalı | netgsm
SMS_PROVIDER=
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_HEADER=

# E-fatura/e-arşiv entegratörü: boş = kapalı (repoda uygulanmış entegratör yok; bkz. app/services/einvoice.py)
EINVOICE_PROVIDER=

# docker-compose.https.yml (Caddy) için Let's Encrypt iletişim e-postası
ACME_EMAIL=
# Mağaza ayarları (satıcı bilgileri, yasal metinler, Havale/EFT, kargo ücreti) panelden yapılır:
# TrendHub → Web Sitesi → Mağaza ayarları.

# --- CORS (varsayılan kapalı; panel nginx ile aynı origin'den servis edilir) ---
# CORS_ORIGINS=

# Not: `python -m app.cli create-user/reset-password` komutları parolayı
# etkileşimli sorar veya TRENDHUB_NEW_PASSWORD değişkeninden okur. Bu değişkeni
# .env dosyasına YAZMAYIN; yalnızca komutu çalıştırırken geçici olarak verin.
