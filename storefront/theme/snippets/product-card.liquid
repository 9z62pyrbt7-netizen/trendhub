{%- comment -%}
  Ürün kartı. Parametreler:
  - product (zorunlu)
  - sizes: görsel sizes değeri
  - priority: ilk ekranda görünen kartlar için true
  - index: animasyon gecikmesi için sıra
{%- endcomment -%}
{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign first_image = product.featured_media.preview_image
  assign second_image = nil
  if settings.card_show_second_image and product.media.size > 1
    assign second_image = product.media[1].preview_image
  endif
  assign sizes = sizes | default: '(min-width: 1200px) 25vw, (min-width: 750px) 33vw, 70vw'

  assign color_names = settings.color_option_names | downcase | split: ','
  assign color_option = nil
  for option in product.options_with_values
    assign option_name = option.name | downcase | strip
    for color_name in color_names
      assign cn = color_name | strip
      if cn == option_name
        assign color_option = option
        break
      endif
    endfor
    if color_option
      break
    endif
  endfor

  assign single_variant = false
  if product.variants.size == 1
    assign single_variant = true
  endif

  assign on_sale = false
  if product.compare_at_price > product.price
    assign on_sale = true
  endif
-%}
<article class="card{% unless product.available %} card--soldout{% endunless %}" data-product-card{% if index %} style="--i: {{ index }}"{% endif %}>
  <div class="card__media">
    <a class="card__media-link" href="{{ product.url }}" data-card-link aria-label="{{ product.title | escape }}" tabindex="-1">
      {%- if first_image -%}
        {%- render 'responsive-image',
          image: first_image,
          widths: '300, 420, 560, 720, 900',
          sizes: sizes,
          class: 'card__img card__img--primary',
          alt: product.title,
          priority: priority
        -%}
        {%- if second_image -%}
          {%- render 'responsive-image',
            image: second_image,
            widths: '300, 420, 560, 720, 900',
            sizes: sizes,
            class: 'card__img card__img--secondary',
            alt: ''
          -%}
        {%- endif -%}
      {%- else -%}
        <span class="card__placeholder">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</span>
      {%- endif -%}
    </a>

    <span class="card__badges">
      {%- unless product.available -%}
        <span class="badge badge--muted">{{ 'products.product.sold_out' | t }}</span>
      {%- elsif on_sale -%}
        <span class="badge badge--sale">{{ 'products.product.on_sale' | t }}</span>
      {%- endunless -%}
    </span>

    <div class="card__actions">
      {%- if settings.card_quick_add and single_variant and product.available -%}
        {%- form 'product', product, class: 'card__form', data-product-form: '' -%}
          <input type="hidden" name="id" value="{{ variant.id }}">
          <button type="submit" name="add" class="card__quick" data-add-button aria-label="{{ 'products.product.add_to_cart' | t }}: {{ product.title | escape }}">
            <span class="card__quick-label" data-add-label>{{ 'products.product.add_to_cart' | t }}</span>
            {% render 'icon', name: 'plus' %}
          </button>
        {%- endform -%}
      {%- else -%}
        <a class="card__quick" href="{{ product.url }}" aria-label="{{ 'products.product.view' | t }}: {{ product.title | escape }}">
          <span class="card__quick-label">{% if product.available %}{{ 'products.product.view' | t }}{% else %}{{ 'products.product.view_details' | t }}{% endif %}</span>
          {% render 'icon', name: 'arrow-right' %}
        </a>
      {%- endif -%}
    </div>
  </div>

  <div class="card__body">
    <h3 class="card__title">
      <a href="{{ product.url }}" data-card-link>{{ product.title | escape }}</a>
    </h3>
    {% render 'price', product: product, class: 'card__price' %}

    {%- if settings.card_show_swatches and color_option and color_option.values.size > 0 -%}
      <ul class="card__swatches" aria-label="{{ color_option.name | escape }}">
        {%- for value in color_option.values limit: 5 -%}
          {%- liquid
            assign swatch_variant = nil
            for v in product.variants
              if v.options contains value
                assign swatch_variant = v
                break
              endif
            endfor
            assign swatch_image = swatch_variant.featured_media.preview_image
          -%}
          <li>
            <button
              type="button"
              class="swatch{% if forloop.first %} is-active{% endif %}"
              style="--swatch: {% render 'color-swatch-value', value: value %}"
              data-card-swatch
              {% if swatch_variant %}data-url="{{ swatch_variant.url }}"{% endif %}
              {% if swatch_image %}data-image="{{ swatch_image | image_url: width: 720 }}"{% endif %}
              aria-label="{{ value | escape }}"
              title="{{ value | escape }}"
            ></button>
          </li>
        {%- endfor -%}
        {%- if color_option.values.size > 5 -%}
          <li class="card__swatch-more">+{{ color_option.values.size | minus: 5 }}</li>
        {%- endif -%}
      </ul>
    {%- endif -%}
  </div>
</article>
