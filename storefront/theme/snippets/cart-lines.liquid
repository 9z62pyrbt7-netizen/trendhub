{%- comment -%} Sepet satırları (yan sepet + sepet sayfası). Parametre: context ('drawer' | 'page') {%- endcomment -%}
<ul class="lines" role="list" data-cart-lines>
  {%- for item in cart.items -%}
    <li class="line" data-line="{{ forloop.index }}" data-key="{{ item.key }}">
      <a class="line__media" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
        {%- if item.image -%}
          <img src="{{ item.image | image_url: width: 240 }}" srcset="{{ item.image | image_url: width: 160 }} 160w, {{ item.image | image_url: width: 240 }} 240w" sizes="120px" alt="" width="120" height="{{ 120 | divided_by: item.image.aspect_ratio | round }}" loading="lazy">
        {%- endif -%}
      </a>
      <div class="line__info">
        <a class="line__title" href="{{ item.url }}">{{ item.product.title | escape }}</a>
        {%- unless item.product.has_only_default_variant -%}
          <p class="line__variant">
            {%- for option in item.options_with_values -%}
              {{ option.name | escape }}: {{ option.value | escape }}{% unless forloop.last %} · {% endunless %}
            {%- endfor -%}
          </p>
        {%- endunless -%}
        {%- for property in item.properties -%}
          {%- assign first_char = property.first | slice: 0 -%}
          {%- if property.last != blank and first_char != '_' -%}
            <p class="line__variant">{{ property.first | escape }}: {{ property.last | escape }}</p>
          {%- endif -%}
        {%- endfor -%}
        {%- if item.selling_plan_allocation -%}<p class="line__variant">{{ item.selling_plan_allocation.selling_plan.name | escape }}</p>{%- endif -%}

        <div class="line__price">
          {%- if item.original_price > item.final_price -%}
            <s>{{ item.original_price | money }}</s>
          {%- endif -%}
          <span>{{ item.final_price | money }}</span>
        </div>
        {%- for discount in item.line_level_discount_allocations -%}
          <p class="line__discount">{{ discount.discount_application.title | escape }} (−{{ discount.amount | money }})</p>
        {%- endfor -%}

        <div class="line__controls">
          <div class="qty qty--sm">
            <button type="button" class="qty__btn" data-line-change="{{ item.quantity | minus: 1 }}" aria-label="{{ 'products.product.quantity_decrease' | t }}">{% render 'icon', name: 'minus' %}</button>
            <label class="visually-hidden" for="Line-{{ context }}-{{ forloop.index }}">{{ 'products.product.quantity' | t }}</label>
            <input class="qty__input" id="Line-{{ context }}-{{ forloop.index }}" type="number" inputmode="numeric" min="0" value="{{ item.quantity }}" name="updates[]" data-line-input>
            <button type="button" class="qty__btn" data-line-change="{{ item.quantity | plus: 1 }}" aria-label="{{ 'products.product.quantity_increase' | t }}">{% render 'icon', name: 'plus' %}</button>
          </div>
          <a class="line__remove" href="{{ item.url_to_remove }}" data-line-change="0">{{ 'cart.remove' | t }}</a>
        </div>
      </div>
      <div class="line__total">{{ item.final_line_price | money }}</div>
    </li>
  {%- endfor -%}
</ul>
