{%- comment -%} Renk adından CSS rengi üretir. Parametre: value {%- endcomment -%}
{%- liquid
  assign v = value | downcase | strip
  case v
    when 'siyah', 'black', 'noir'
      echo '#141210'
    when 'beyaz', 'white', 'ekru', 'ecru', 'kırık beyaz', 'off white', 'off-white'
      echo '#F4F0E8'
    when 'krem', 'cream', 'ivory', 'fildişi'
      echo '#EDE3D1'
    when 'bej', 'beige', 'nude', 'ten'
      echo '#D8C3A5'
    when 'kahverengi', 'kahve', 'brown', 'chocolate', 'çikolata'
      echo '#5E3B28'
    when 'taba', 'tan', 'cognac', 'konyak', 'camel', 'deve tüyü'
      echo '#A8703D'
    when 'vizon', 'mink', 'taupe'
      echo '#9C8B7A'
    when 'gri', 'grey', 'gray', 'füme', 'antrasit'
      echo '#7F7B76'
    when 'lacivert', 'navy'
      echo '#1F2A44'
    when 'mavi', 'blue', 'bebek mavisi'
      echo '#4A6D9B'
    when 'kırmızı', 'red'
      echo '#A1271F'
    when 'bordo', 'burgundy', 'wine', 'şarap'
      echo '#5E1A22'
    when 'pembe', 'pink', 'pudra', 'powder', 'blush'
      echo '#E4BDB6'
    when 'yeşil', 'green', 'haki', 'khaki', 'olive', 'zeytin', 'zümrüt', 'emerald'
      echo '#4D5B3C'
    when 'sarı', 'yellow', 'hardal', 'mustard'
      echo '#D1A53C'
    when 'turuncu', 'orange'
      echo '#CF6D33'
    when 'mor', 'purple', 'lila', 'lilac'
      echo '#6C4E7C'
    when 'gümüş', 'silver'
      echo '#C4C4C4'
    when 'altın', 'gold'
      echo '#C9A45C'
    else
      echo '#D8CBB8'
  endcase
-%}
