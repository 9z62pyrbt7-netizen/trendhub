{%- comment -%} Parametreler: url, title, image, count {%- endcomment -%}
<a class="tile" href="{{ url }}">
  <span class="tile__media">
    {%- if image -%}
      {%- render 'responsive-image', image: image, widths: '360, 540, 720, 900', sizes: '(min-width: 990px) 33vw, 80vw', class: 'tile__img', alt: title -%}
    {%- else -%}
      {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg tile__img' }}
    {%- endif -%}
  </span>
  <span class="tile__body">
    <span class="tile__title">{{ title | escape }}</span>
    <span class="tile__meta">
      {%- if count -%}{{ 'sections.tiles.count' | t: count: count }}{%- else -%}{{ 'sections.tiles.discover' | t }}{%- endif -%}
      {% render 'icon', name: 'arrow-right' %}
    </span>
  </span>
</a>
