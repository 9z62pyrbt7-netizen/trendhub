{%- comment -%}
  Fiyat. Parametreler: product (zorunlu), variant (isteğe bağlı), class
  İndirim yalnızca gerçek "karşılaştırma fiyatı" satış fiyatından yüksekse gösterilir.
{%- endcomment -%}
{%- liquid
  assign target = variant | default: product.selected_or_first_available_variant
  assign price = target.price
  assign compare_at = target.compare_at_price
  assign on_sale = false
  if compare_at > price
    assign on_sale = true
  endif
  assign varies = false
  if variant == blank and product.price_varies
    assign varies = true
    assign price = product.price_min
  endif
-%}
<div class="price{% if on_sale %} price--sale{% endif %}{% if class %} {{ class }}{% endif %}" data-price>
  {%- if varies -%}
    {%- assign price_money = price | money -%}
    <span class="price__current">{{ 'products.product.price_from' | t: price: price_money }}</span>
  {%- else -%}
    <span class="visually-hidden">{% if on_sale %}{{ 'products.product.sale_price' | t }}{% else %}{{ 'products.product.regular_price' | t }}{% endif %}</span>
    <span class="price__current" data-price-current>{{ price | money }}</span>
  {%- endif -%}
  <span class="price__compare"{% unless on_sale %} hidden{% endunless %}>
    <span class="visually-hidden">{{ 'products.product.regular_price' | t }}</span>
    <s data-price-compare>{% if on_sale %}{{ compare_at | money }}{% endif %}</s>
  </span>
  <span class="price__badge" data-price-badge{% unless on_sale %} hidden{% endunless %}>
    {%- if on_sale -%}
      {%- assign saving = compare_at | minus: price | times: 100.0 | divided_by: compare_at | round -%}
      -%{{ saving }}
    {%- endif -%}
  </span>
</div>
