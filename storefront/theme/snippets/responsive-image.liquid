{%- comment -%}
  Duyarlı görsel. Parametreler:
  - image (zorunlu), widths (virgülle), sizes, class, alt, loading ('lazy' | 'eager'), priority (true → fetchpriority=high)
{%- endcomment -%}
{%- liquid
  assign widths = widths | default: '360, 540, 720, 900, 1080, 1296, 1512'
  assign sizes = sizes | default: '100vw'
  assign loading = loading | default: 'lazy'
  assign alt_text = alt | default: image.alt | escape
  assign width_list = widths | split: ','
  assign srcset = ''
  for w in width_list
    assign w_int = w | strip | plus: 0
    if w_int <= image.width
      assign url = image | image_url: width: w_int
      assign srcset = srcset | append: url | append: ' ' | append: w_int | append: 'w, '
    endif
  endfor
  if srcset == ''
    assign url = image | image_url
    assign srcset = url | append: ' ' | append: image.width | append: 'w'
  else
    assign srcset = srcset | remove_last: ', '
  endif
  assign last_w = width_list | last | strip | plus: 0
  if last_w > image.width
    assign last_w = image.width
  endif
-%}
<img
  src="{{ image | image_url: width: last_w }}"
  srcset="{{ srcset }}"
  sizes="{{ sizes }}"
  alt="{{ alt_text }}"
  width="{{ image.width }}"
  height="{{ image.height }}"
  {% if class %}class="{{ class }}"{% endif %}
  {% if priority %}fetchpriority="high" loading="eager"{% else %}loading="{{ loading }}"{% endif %}
  decoding="async"
>
