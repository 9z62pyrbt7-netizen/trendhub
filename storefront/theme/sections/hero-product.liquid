{%- liquid
  assign hero = section.settings.product
  if hero == blank or hero.featured_media == blank
    for p in collections.all.products limit: 24
      if p.available and p.featured_media
        assign hero = p
        break
      endif
    endfor
  endif

  assign display_title = section.settings.display_title | default: hero.title
  assign variant = hero.selected_or_first_available_variant
  assign secondary_link = routes.all_products_collection_url
  if section.settings.collection != blank
    assign secondary_link = section.settings.collection.url
  endif
  assign hero_image = hero.featured_media.preview_image
  if section.settings.image_override != blank
    assign hero_image = section.settings.image_override
  endif
-%}

<section
  class="hero{% if section.settings.enable_scroll %} hero--motion{% endif %}"
  data-hero
  aria-label="{{ settings.brand_name | escape }}"
>
  <div class="hero__track" data-hero-track>
    <div class="hero__stage" data-hero-stage>
      <div class="hero__bg" aria-hidden="true">
        <span class="hero__arc"></span>
      </div>

      <p class="hero__wordmark" aria-hidden="true" data-hero-wordmark>
        {{- section.settings.wordmark | default: settings.brand_name | escape | replace: '|', '<span class="hero__wm-break"></span>' -}}
      </p>

      <div class="hero__product" data-hero-product>
        {%- if hero_image -%}
          <a class="hero__product-link" href="{{ hero.url }}" tabindex="-1" aria-hidden="true">
            {%- render 'responsive-image',
              image: hero_image,
              widths: '480, 640, 800, 1000, 1200, 1500',
              sizes: '(min-width: 1200px) 44vw, (min-width: 750px) 60vw, 88vw',
              class: 'hero__img',
              alt: hero.title,
              priority: true
            -%}
          </a>
          <span class="hero__shadow" aria-hidden="true"></span>
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg hero__img' }}
        {%- endif -%}
      </div>

      <div class="hero__copy container">
        <div class="hero__intro" data-hero-intro>
          {%- if section.settings.eyebrow != blank -%}
            <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          <h1 class="hero__title">
            <span class="visually-hidden">{{ settings.brand_name | default: shop.name }} — </span>
            {{- section.settings.heading | escape -}}
          </h1>
          {%- if section.settings.subheading != blank -%}
            <p class="hero__sub">{{ section.settings.subheading | escape }}</p>
          {%- endif -%}
          <div class="hero__ctas">
            {%- if hero != blank -%}
              <a class="btn btn--dark" href="{{ hero.url }}">
                <span>{{ section.settings.primary_label }}</span>{% render 'icon', name: 'arrow-right' %}
              </a>
            {%- endif -%}
            <a class="btn btn--ghost" href="{{ secondary_link }}">{{ section.settings.secondary_label }}</a>
          </div>
        </div>

        {%- if hero != blank -%}
          <div class="hero__detail" data-hero-detail>
            {%- if section.settings.detail_eyebrow != blank -%}
              <p class="eyebrow">{{ section.settings.detail_eyebrow | escape }}</p>
            {%- endif -%}
            <h2 class="hero__detail-title"><a href="{{ hero.url }}">{{ display_title | escape }}</a></h2>
            {% render 'price', product: hero, variant: variant, class: 'hero__price' %}
            {%- if hero.variants.size > 1 -%}
              <p class="hero__meta">{{ 'sections.hero.options' | t: count: hero.variants.size }}</p>
            {%- elsif variant.title != 'Default Title' -%}
              <p class="hero__meta">{{ variant.title | escape }}</p>
            {%- endif -%}
            <div class="hero__ctas">
              {%- if hero.variants.size == 1 and hero.available -%}
                {%- form 'product', hero, data-product-form: '' -%}
                  <input type="hidden" name="id" value="{{ variant.id }}">
                  <button type="submit" name="add" class="btn btn--dark" data-add-button>
                    <span data-add-label>{{ 'products.product.add_to_cart' | t }}</span>{% render 'icon', name: 'bag' %}
                  </button>
                {%- endform -%}
                <a class="btn btn--ghost" href="{{ hero.url }}">{{ section.settings.primary_label }}</a>
              {%- else -%}
                <a class="btn btn--dark" href="{{ hero.url }}"><span>{{ section.settings.primary_label }}</span>{% render 'icon', name: 'arrow-right' %}</a>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      </div>

      <span class="hero__cue" aria-hidden="true"><span></span></span>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero · Öne çıkan çanta",
  "class": "section-hero",
  "settings": [
    { "type": "product", "id": "product", "label": "Hero ürünü", "info": "Boş bırakılırsa ilk stokta olan ürün kullanılır. Öncelik: en çok satan → en çok ilgi gören → görseli en güçlü ürün." },
    { "type": "image_picker", "id": "image_override", "label": "Farklı ürün görseli (isteğe bağlı)", "info": "Arka planı beyaz/şeffaf, ürünün tamamının göründüğü bir kare görsel en iyi sonucu verir." },
    { "type": "text", "id": "display_title", "label": "Görünen ürün adı", "info": "Uzun pazaryeri başlıkları yerine kısa bir ad. Boşsa ürün adı kullanılır." },
    { "type": "text", "id": "wordmark", "label": "Büyük marka yazısı", "default": "TREND|ÇANTANIZ", "info": "\"|\" işareti mobilde satır sonu olur, masaüstünde birleşik yazılır." },
    { "type": "text", "id": "eyebrow", "label": "Üst başlık", "default": "Kadın çanta koleksiyonu" },
    { "type": "text", "id": "heading", "label": "Başlık", "default": "Tarzını yanında taşı." },
    { "type": "text", "id": "subheading", "label": "Alt metin" },
    { "type": "text", "id": "primary_label", "label": "Birincil buton", "default": "Ürünü İncele" },
    { "type": "text", "id": "secondary_label", "label": "İkincil buton", "default": "Koleksiyonu Keşfet" },
    { "type": "collection", "id": "collection", "label": "İkincil buton koleksiyonu", "info": "Boşsa tüm ürünler." },
    { "type": "text", "id": "detail_eyebrow", "label": "Kaydırınca görünen üst başlık", "default": "Öne çıkan" },
    { "type": "checkbox", "id": "enable_scroll", "label": "Kaydırmaya tepki veren ürün animasyonu", "default": true }
  ],
  "presets": [{ "name": "Hero · Öne çıkan çanta" }]
}
{% endschema %}
