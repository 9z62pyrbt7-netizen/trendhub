{%- paginate search.results by 24 -%}
  <section class="section search-page">
    <div class="container">
      <h1 class="page-title">{% if search.performed %}{{ 'search.results_for' | t: terms: search.terms }}{% else %}{{ 'search.title' | t }}{% endif %}</h1>
      <form action="{{ routes.search_url }}" method="get" role="search" class="search-form search-form--page">
        <input type="hidden" name="type" value="product">
        <label class="visually-hidden" for="SearchPageInput">{{ 'sections.header.search' | t }}</label>
        {% render 'icon', name: 'search' %}
        <input id="SearchPageInput" class="search-form__input" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'sections.header.search_placeholder' | t }}">
        <button type="submit" class="btn btn--dark btn--sm">{{ 'search.submit' | t }}</button>
      </form>

      {%- if search.performed -%}
        <p class="toolbar__total">{{ 'search.count' | t: count: search.results_count }}</p>
        {%- if search.results_count > 0 -%}
          <ul class="grid" role="list">
            {%- for item in search.results -%}
              <li class="grid__item">
                {%- if item.object_type == 'product' -%}
                  {% render 'product-card', product: item, sizes: '(min-width: 1200px) 25vw, (min-width: 750px) 33vw, 50vw' %}
                {%- else -%}
                  <a class="search-result" href="{{ item.url }}">
                    <span class="eyebrow">{{ item.object_type }}</span>
                    <span class="search-result__title">{{ item.title | escape }}</span>
                  </a>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        {%- else -%}
          <div class="empty">
            <p class="empty__title">{{ 'search.no_results' | t }}</p>
            <a class="btn btn--dark" href="{{ routes.all_products_collection_url }}">{{ 'sections.tiles.all_bags' | t }}</a>
          </div>
        {%- endif -%}
        {% render 'pagination', paginate: paginate %}
      {%- endif -%}
    </div>
  </section>
{%- endpaginate -%}

{% schema %}
{ "name": "Arama sonuçları", "class": "section-main-search", "settings": [] }
{% endschema %}
