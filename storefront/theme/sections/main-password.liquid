<section class="password">
  <div class="password__inner">
    <p class="wordmark wordmark--xl">{{ settings.brand_name | default: shop.name }}</p>
    {%- if section.settings.heading != blank -%}<h1 class="password__title">{{ section.settings.heading | escape }}</h1>{%- endif -%}
    {%- if shop.password_message != blank -%}<p class="password__message">{{ shop.password_message }}</p>{%- endif -%}

    {%- form 'customer', class: 'newsletter password__form' -%}
      <input type="hidden" name="contact[tags]" value="prospect,password page">
      {%- if form.posted_successfully? -%}
        <p class="form-message form-message--ok" role="status">{% render 'icon', name: 'check' %} {{ 'sections.footer.newsletter_ok' | t }}</p>
      {%- else -%}
        <p class="footer__note">{{ 'password.notify' | t }}</p>
        <div class="newsletter__field">
          <label class="visually-hidden" for="PasswordEmail">{{ 'customer.email' | t }}</label>
          <input id="PasswordEmail" type="email" name="contact[email]" required autocomplete="email" placeholder="{{ 'customer.email' | t }}">
          <button type="submit" aria-label="{{ 'sections.footer.subscribe' | t }}">{% render 'icon', name: 'arrow-right' %}</button>
        </div>
        {%- if form.errors -%}<p class="form-message form-message--error">{{ form.errors | default_errors }}</p>{%- endif -%}
      {%- endif -%}
    {%- endform -%}

    <details class="password__login">
      <summary>{{ 'password.owner' | t }}</summary>
      {%- form 'storefront_password', class: 'newsletter' -%}
        <div class="newsletter__field">
          <label class="visually-hidden" for="StorePassword">{{ 'password.password' | t }}</label>
          <input id="StorePassword" type="password" name="password" autocomplete="current-password" placeholder="{{ 'password.password' | t }}" required>
          <button type="submit" aria-label="{{ 'password.enter' | t }}">{% render 'icon', name: 'arrow-right' %}</button>
        </div>
        {%- if form.errors -%}<p class="form-message form-message--error">{{ form.errors | default_errors }}</p>{%- endif -%}
      {%- endform -%}
      <p class="password__admin">{{ 'password.admin_html' | t: link: '/admin' }}</p>
    </details>
  </div>
</section>

{% schema %}
{
  "name": "Şifre sayfası",
  "class": "section-password",
  "settings": [ { "type": "text", "id": "heading", "label": "Başlık", "default": "Çok yakında." } ]
}
{% endschema %}
