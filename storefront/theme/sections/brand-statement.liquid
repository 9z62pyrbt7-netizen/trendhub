<section class="section statement" aria-label="{{ section.settings.heading | strip_html | escape }}">
  <div class="container statement__inner" data-reveal>
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
    <p class="statement__text">{{ section.settings.heading }}</p>
    {%- if section.settings.button_label != blank -%}
      <a class="link-arrow" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }}{% render 'icon', name: 'arrow-right' %}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Marka cümlesi",
  "class": "section-statement",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Üst başlık", "default": "Trendçantanız" },
    { "type": "inline_richtext", "id": "heading", "label": "Metin", "default": "Her gün yanında taşıdığın şey, <em>tarzının</em> en sade hâli olmalı." },
    { "type": "text", "id": "button_label", "label": "Bağlantı metni", "default": "Tüm çantaları gör" },
    { "type": "url", "id": "button_link", "label": "Bağlantı" }
  ],
  "presets": [{ "name": "Marka cümlesi" }]
}
{% endschema %}
