<section class="section cart-page" data-cart-page>
  <div class="container">
    <div class="page-head">
      <h1 class="page-title">{{ 'cart.title' | t }}</h1>
      {%- if cart.item_count > 0 -%}
        <a class="link-arrow" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue' | t }}{% render 'icon', name: 'arrow-right' %}</a>
      {%- endif -%}
    </div>

    <div data-cart-page-inner>
      {%- if cart.item_count > 0 -%}
        <div class="cart-page__grid">
          <form action="{{ routes.cart_url }}" method="post" id="CartPageForm" class="cart-page__lines" novalidate>
            {% render 'cart-lines', context: 'page' %}
            {%- if settings.cart_show_note -%}
              <div class="cart-note cart-note--open">
                <label for="CartPageNote">{{ 'cart.note' | t }}</label>
                <textarea id="CartPageNote" name="note" rows="3" data-cart-note>{{ cart.note }}</textarea>
              </div>
            {%- endif -%}
            <noscript><button type="submit" name="update" class="btn btn--ghost">{{ 'cart.update' | t }}</button></noscript>
          </form>
          <aside class="cart-page__summary" aria-label="{{ 'cart.summary' | t }}">
            {% render 'cart-summary', form_id: 'CartPageForm' %}
            {%- if additional_checkout_buttons and section.settings.show_dynamic -%}
              <div class="summary__dynamic">{{ content_for_additional_checkout_buttons }}</div>
            {%- endif -%}
          </aside>
        </div>
      {%- else -%}
        <div class="cart-empty cart-empty--page">
          <span class="cart-empty__icon">{% render 'icon', name: 'bag' %}</span>
          <p class="cart-empty__title">{{ 'cart.empty' | t }}</p>
          <p class="cart-empty__text">{{ 'cart.empty_text' | t }}</p>
          <a class="btn btn--dark" href="{{ routes.all_products_collection_url }}"><span>{{ 'cart.continue' | t }}</span>{% render 'icon', name: 'arrow-right' %}</a>
          {%- if shop.customer_accounts_enabled and customer == nil -%}
            <p class="cart-empty__login">{{ 'cart.login_html' | t: link: routes.account_login_url }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Sepet",
  "class": "section-main-cart",
  "settings": [
    { "type": "checkbox", "id": "show_dynamic", "label": "Hızlı ödeme butonlarını göster", "default": true }
  ]
}
{% endschema %}
