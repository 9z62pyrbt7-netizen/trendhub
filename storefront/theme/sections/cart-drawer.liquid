<div class="drawer drawer--right" id="CartDrawer" data-drawer="cart" aria-hidden="true">
  <div class="drawer__overlay" data-drawer-close></div>
  <div class="drawer__panel cart-drawer" role="dialog" aria-modal="true" aria-labelledby="CartDrawerTitle" tabindex="-1">
    <div class="cart-drawer__inner" data-cart-drawer-inner>
      <div class="drawer__head">
        <h2 class="drawer__title" id="CartDrawerTitle">{{ 'cart.title' | t }} <span class="drawer__count">({{ cart.item_count }})</span></h2>
        <button type="button" class="header__icon" data-drawer-close aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button>
      </div>

      {%- if cart.item_count > 0 -%}
        <form action="{{ routes.cart_url }}" method="post" id="CartDrawerForm" class="drawer__body" novalidate>
          {% render 'cart-lines', context: 'drawer' %}
          {%- if settings.cart_show_note -%}
            <details class="cart-note">
              <summary>{{ 'cart.note' | t }}{% render 'icon', name: 'plus' %}</summary>
              <label class="visually-hidden" for="CartDrawerNote">{{ 'cart.note' | t }}</label>
              <textarea id="CartDrawerNote" name="note" rows="3" data-cart-note>{{ cart.note }}</textarea>
            </details>
          {%- endif -%}
        </form>
        <div class="drawer__foot">
          {% render 'cart-summary', form_id: 'CartDrawerForm' %}
          <a class="link-quiet" href="{{ routes.cart_url }}">{{ 'cart.view_cart' | t }}</a>
        </div>
      {%- else -%}
        <div class="drawer__body cart-empty">
          <span class="cart-empty__icon">{% render 'icon', name: 'bag' %}</span>
          <p class="cart-empty__title">{{ 'cart.empty' | t }}</p>
          <p class="cart-empty__text">{{ 'cart.empty_text' | t }}</p>
          <a class="btn btn--dark" href="{{ routes.all_products_collection_url }}"><span>{{ 'cart.continue' | t }}</span>{% render 'icon', name: 'arrow-right' %}</a>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Yan sepet",
  "class": "section-cart-drawer",
  "settings": []
}
{% endschema %}
