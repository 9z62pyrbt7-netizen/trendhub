{%- liquid
  assign menu = section.settings.menu
  assign is_transparent = false
  if section.settings.transparent_on_home and request.page_type == 'index'
    assign is_transparent = true
  endif
  assign new_url = routes.all_products_collection_url | append: '?sort_by=created-descending'
  assign best_url = routes.all_products_collection_url | append: '?sort_by=best-selling'
  if section.settings.new_collection != blank
    assign new_url = section.settings.new_collection.url
  endif
  if section.settings.best_collection != blank
    assign best_url = section.settings.best_collection.url
  endif
-%}
<header
  class="header{% if is_transparent %} header--transparent{% endif %}"
  data-header
  {% if is_transparent %}data-transparent{% endif %}
>
  <div class="header__inner container">
    <div class="header__left">
      <button type="button" class="header__icon header__burger" data-drawer-open="menu" aria-controls="MenuDrawer" aria-expanded="false" aria-label="{{ 'sections.header.menu' | t }}">
        {% render 'icon', name: 'menu' %}
      </button>

      <nav class="header__nav" aria-label="{{ 'sections.header.main_nav' | t }}">
        <ul class="nav">
          {%- if menu != blank -%}
            {%- for link in menu.links -%}
              {%- if link.url == routes.root_url -%}{%- continue -%}{%- endif -%}
              <li class="nav__item{% if link.links.size > 0 %} nav__item--has-children{% endif %}">
                <a class="nav__link{% if link.active or link.child_active %} is-active{% endif %}" href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>
                  {{ link.title | escape }}
                  {%- if link.links.size > 0 -%}{% render 'icon', name: 'chevron-down' %}{%- endif -%}
                </a>
                {%- if link.links.size > 0 -%}
                  <div class="nav__dropdown">
                    <ul>
                      {%- for child in link.links -%}
                        <li><a href="{{ child.url }}"{% if child.current %} aria-current="page"{% endif %}>{{ child.title | escape }}</a></li>
                      {%- endfor -%}
                    </ul>
                  </div>
                {%- endif -%}
              </li>
            {%- endfor -%}
          {%- else -%}
            <li class="nav__item"><a class="nav__link" href="{{ routes.all_products_collection_url }}">{{ 'sections.header.all_bags' | t }}</a></li>
          {%- endif -%}
          {%- if section.settings.show_new_link -%}
            <li class="nav__item"><a class="nav__link" href="{{ new_url }}">{{ 'sections.header.new_in' | t }}</a></li>
          {%- endif -%}
          {%- if section.settings.show_best_link -%}
            <li class="nav__item"><a class="nav__link" href="{{ best_url }}">{{ 'sections.header.best_sellers' | t }}</a></li>
          {%- endif -%}
        </ul>
      </nav>
    </div>

    <div class="header__brand">
      <div class="header__logo-wrap">
        <a href="{{ routes.root_url }}" class="header__logo">
          {%- if settings.logo != blank -%}
            {%- assign logo_w2 = settings.logo_width | times: 2 -%}
            <img
              src="{{ settings.logo | image_url: width: logo_w2 }}"
              alt="{{ settings.logo.alt | default: shop.name | escape }}"
              width="{{ settings.logo_width }}"
              height="{{ settings.logo_width | divided_by: settings.logo.aspect_ratio | round }}"
              style="width: {{ settings.logo_width }}px"
            >
          {%- else -%}
            <span class="wordmark">{{ settings.brand_name | default: shop.name }}</span>
          {%- endif -%}
        </a>
      </div>
    </div>

    <div class="header__right">
      <button type="button" class="header__icon" data-search-open aria-controls="SearchPanel" aria-expanded="false" aria-label="{{ 'sections.header.search' | t }}">
        {% render 'icon', name: 'search' %}
      </button>
      {%- if shop.customer_accounts_enabled -%}
        <a class="header__icon header__account" href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" aria-label="{{ 'sections.header.account' | t }}">
          {% render 'icon', name: 'user' %}
        </a>
      {%- endif -%}
      <a class="header__icon header__cart" href="{{ routes.cart_url }}" data-cart-open>
        {% render 'icon', name: 'bag' %}
        <span class="cart-count{% if cart.item_count == 0 %} is-empty{% endif %}" data-cart-count aria-hidden="true">{{ cart.item_count }}</span>
        <span class="visually-hidden">{{ 'sections.header.cart' | t }}, <span data-cart-count-label>{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span></span>
      </a>
    </div>
  </div>

  <div class="search-panel" id="SearchPanel" data-search-panel hidden>
    <div class="container search-panel__inner">
      <form action="{{ routes.search_url }}" method="get" role="search" class="search-form">
        <input type="hidden" name="type" value="product">
        <label class="visually-hidden" for="HeaderSearch">{{ 'sections.header.search' | t }}</label>
        {% render 'icon', name: 'search' %}
        <input
          id="HeaderSearch"
          class="search-form__input"
          type="search"
          name="q"
          placeholder="{{ 'sections.header.search_placeholder' | t }}"
          autocomplete="off"
          autocorrect="off"
          spellcheck="false"
          data-predictive-input
        >
        <button type="button" class="header__icon" data-search-close aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button>
      </form>
      <div class="predictive" data-predictive-results aria-live="polite"></div>
    </div>
  </div>
</header>

<div class="drawer drawer--left" id="MenuDrawer" data-drawer="menu" aria-hidden="true">
  <div class="drawer__overlay" data-drawer-close></div>
  <div class="drawer__panel" role="dialog" aria-modal="true" aria-label="{{ 'sections.header.menu' | t }}" tabindex="-1">
    <div class="drawer__head">
      <span class="wordmark wordmark--sm">{{ settings.brand_name | default: shop.name }}</span>
      <button type="button" class="header__icon" data-drawer-close aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button>
    </div>
    <nav class="drawer__body mobile-nav" aria-label="{{ 'sections.header.main_nav' | t }}">
      <ul>
        {%- if section.settings.show_new_link -%}
          <li><a href="{{ new_url }}">{{ 'sections.header.new_in' | t }}</a></li>
        {%- endif -%}
        {%- if section.settings.show_best_link -%}
          <li><a href="{{ best_url }}">{{ 'sections.header.best_sellers' | t }}</a></li>
        {%- endif -%}
        {%- if menu != blank -%}
          {%- for link in menu.links -%}
            {%- if link.links.size > 0 -%}
              <li>
                <details>
                  <summary>{{ link.title | escape }} {% render 'icon', name: 'plus' %}</summary>
                  <ul class="mobile-nav__sub">
                    <li><a href="{{ link.url }}">{{ 'sections.header.view_all' | t }}</a></li>
                    {%- for child in link.links -%}
                      <li><a href="{{ child.url }}">{{ child.title | escape }}</a></li>
                    {%- endfor -%}
                  </ul>
                </details>
              </li>
            {%- else -%}
              <li><a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a></li>
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          <li><a href="{{ routes.all_products_collection_url }}">{{ 'sections.header.all_bags' | t }}</a></li>
        {%- endif -%}
      </ul>
    </nav>
    <div class="drawer__foot mobile-nav__foot">
      {%- if shop.customer_accounts_enabled -%}
        <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" class="mobile-nav__util">
          {% render 'icon', name: 'user' %}
          {% if customer %}{{ 'sections.header.account' | t }}{% else %}{{ 'customer.log_in' | t }}{% endif %}
        </a>
      {%- endif -%}
      {% render 'social-links' %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Üst menü",
  "class": "section-header",
  "enabled_on": { "groups": ["header"] },
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Menü", "default": "main-menu" },
    { "type": "checkbox", "id": "transparent_on_home", "label": "Ana sayfada hero üzerinde şeffaf", "default": true },
    { "type": "checkbox", "id": "show_new_link", "label": "\"Yeni Gelenler\" bağlantısını göster", "default": true },
    { "type": "collection", "id": "new_collection", "label": "Yeni Gelenler koleksiyonu", "info": "Boşsa tüm ürünler en yeniden eskiye sıralanır." },
    { "type": "checkbox", "id": "show_best_link", "label": "\"Çok Satanlar\" bağlantısını göster", "default": true },
    { "type": "collection", "id": "best_collection", "label": "Çok Satanlar koleksiyonu", "info": "Boşsa tüm ürünler Shopify satış verisine göre sıralanır." }
  ]
}
{% endschema %}
