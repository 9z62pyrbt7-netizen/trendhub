{%- if section.blocks.size > 0 -%}
  <section class="section section--tight trust" aria-label="{{ section.settings.label | escape }}">
    <div class="container">
      <ul class="trust__list" role="list">
        {%- for block in section.blocks -%}
          <li class="trust__item" data-reveal style="--i: {{ forloop.index0 }}" {{ block.shopify_attributes }}>
            <span class="trust__icon">{% render 'icon', name: block.settings.icon %}</span>
            <span class="trust__text">
              <strong>{{ block.settings.title | escape }}</strong>
              {%- if block.settings.text != blank -%}<span>{{ block.settings.text | escape }}</span>{%- endif -%}
            </span>
            {%- if block.settings.link != blank -%}<a class="trust__link" href="{{ block.settings.link }}" aria-label="{{ block.settings.title | escape }}"></a>{%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Güven unsurları",
  "class": "section-trust",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "label", "label": "Erişilebilirlik etiketi", "default": "Alışveriş güvenceleri" },
    { "type": "paragraph", "content": "Yalnızca mağazanızda gerçekten geçerli olan hizmetleri ekleyin." }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Güvence",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Simge",
          "options": [
            { "value": "lock", "label": "Kilit" },
            { "value": "truck", "label": "Kargo" },
            { "value": "chat", "label": "Destek" },
            { "value": "return", "label": "İade" },
            { "value": "check", "label": "Onay" },
            { "value": "sparkle", "label": "Yıldız" }
          ],
          "default": "lock"
        },
        { "type": "text", "id": "title", "label": "Başlık", "default": "Güvenli Ödeme" },
        { "type": "text", "id": "text", "label": "Açıklama" },
        { "type": "url", "id": "link", "label": "Bağlantı" }
      ]
    }
  ],
  "presets": [{ "name": "Güven unsurları" }]
}
{% endschema %}
