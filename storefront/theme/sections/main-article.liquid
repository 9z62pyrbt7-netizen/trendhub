<article class="section page">
  <div class="container container--narrow">
    <p class="eyebrow">{{ article.published_at | time_tag: format: 'date' }}</p>
    <h1 class="page-title">{{ article.title | escape }}</h1>
    {%- if article.image -%}
      <div class="article__image">{% render 'responsive-image', image: article.image, widths: '600, 900, 1200', sizes: '(min-width: 990px) 760px, 100vw', alt: article.title, priority: true %}</div>
    {%- endif -%}
    <div class="rte">{{ article.content }}</div>
  </div>
</article>

{% schema %}
{ "name": "Yazı", "class": "section-main-article", "settings": [] }
{% endschema %}
