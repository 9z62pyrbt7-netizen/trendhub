{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign featured = current_variant.featured_media | default: product.featured_media
  assign color_names = settings.color_option_names | downcase | split: ','
  assign form_id = 'ProductForm-' | append: section.id
  assign low_stock_threshold = section.settings.low_stock_threshold
-%}

<section class="product" data-product-section data-section-id="{{ section.id }}" data-url="{{ product.url }}">
  <div class="container">
    <nav class="breadcrumb" aria-label="{{ 'general.breadcrumb' | t }}">
      <ol>
        <li><a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a></li>
        {%- if collection -%}
          <li><a href="{{ collection.url }}">{{ collection.title | escape }}</a></li>
        {%- else -%}
          <li><a href="{{ routes.all_products_collection_url }}">{{ 'sections.tiles.all_bags' | t }}</a></li>
        {%- endif -%}
        <li aria-current="page">{{ product.title | truncatewords: 6 | escape }}</li>
      </ol>
    </nav>

    <div class="product__grid">
      {%- comment -%} Galeri {%- endcomment -%}
      <div class="product__gallery" data-gallery>
        <ul class="gallery" data-gallery-track role="list" aria-label="{{ 'products.product.gallery' | t }}">
          {%- for media in product.media -%}
            <li
              class="gallery__item{% if media.id == featured.id %} is-current{% endif %}"
              data-media-id="{{ media.id }}"
              id="Media-{{ section.id }}-{{ media.id }}"
            >
              <button type="button" class="gallery__zoom" data-zoom-open="{{ forloop.index0 }}" aria-label="{{ 'products.product.zoom' | t }}">
                {%- if media.media_type == 'image' -%}
                  {%- liquid
                    assign is_first = false
                    if forloop.first
                      assign is_first = true
                    endif
                  -%}
                  {%- render 'responsive-image',
                    image: media.preview_image,
                    widths: '400, 600, 800, 1000, 1200, 1500',
                    sizes: '(min-width: 1200px) 34vw, (min-width: 750px) 52vw, 100vw',
                    class: 'gallery__img',
                    alt: media.alt,
                    priority: is_first
                  -%}
                {%- else -%}
                  <span class="gallery__media-other">{{ media | media_tag: image_size: '1200x' }}</span>
                {%- endif -%}
              </button>
            </li>
          {%- else -%}
            <li class="gallery__item">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg gallery__img' }}</li>
          {%- endfor -%}
        </ul>
        {%- if product.media.size > 1 -%}
          <div class="gallery__nav" aria-hidden="true">
            <span class="gallery__counter"><span data-gallery-index>1</span> / {{ product.media.size }}</span>
            <span class="gallery__dots">
              {%- for media in product.media -%}<span class="gallery__dot{% if forloop.first %} is-active{% endif %}"></span>{%- endfor -%}
            </span>
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} Bilgi {%- endcomment -%}
      <div class="product__info">
        <div class="product__sticky">
          <h1 class="product__title">{{ product.title | escape }}</h1>

          <div class="product__price-row">
            {% render 'price', product: product, variant: current_variant, class: 'price--lg' %}
          </div>
          {%- if cart.taxes_included or shop.shipping_policy.body != blank -%}
            <p class="product__tax">
              {%- if cart.taxes_included -%}{{ 'products.product.include_taxes' | t }}{%- endif -%}
              {%- if shop.shipping_policy.body != blank -%}
                {{ 'products.product.shipping_policy_html' | t: link: shop.shipping_policy.url }}
              {%- endif -%}
            </p>
          {%- endif -%}

          {%- form 'product', product, id: form_id, class: 'product__form', novalidate: 'novalidate', data-product-form: '', data-main-form: '' -%}
            <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>

            {%- unless product.has_only_default_variant -%}
              <div class="variants" data-variant-picker>
                {%- for option in product.options_with_values -%}
                  {%- liquid
                    assign option_index = forloop.index0
                    assign option_name = option.name | downcase | strip
                    assign is_color = false
                    for color_name in color_names
                      assign cn = color_name | strip
                      if cn == option_name
                        assign is_color = true
                      endif
                    endfor
                  -%}
                  <fieldset class="variants__group">
                    <legend class="variants__legend">
                      {{ option.name | escape }}: <span data-option-selected="{{ forloop.index0 }}">{{ option.selected_value | escape }}</span>
                    </legend>
                    <div class="variants__values{% if is_color %} variants__values--swatch{% endif %}">
                      {%- for value in option.values -%}
                        {%- assign input_id = section.id | append: '-' | append: option_index | append: '-' | append: forloop.index0 -%}
                        <input
                          type="radio"
                          class="visually-hidden"
                          id="Option-{{ input_id }}"
                          name="option-{{ section.id }}-{{ option_index }}"
                          value="{{ value | escape }}"
                          data-option-index="{{ option_index }}"
                          {% if option.selected_value == value %}checked{% endif %}
                        >
                        {%- if is_color -%}
                          <label for="Option-{{ input_id }}" class="swatch swatch--lg" style="--swatch: {% render 'color-swatch-value', value: value %}" title="{{ value | escape }}">
                            <span class="visually-hidden">{{ value | escape }}</span>
                          </label>
                        {%- else -%}
                          <label for="Option-{{ input_id }}" class="pill">{{ value | escape }}</label>
                        {%- endif -%}
                      {%- endfor -%}
                    </div>
                  </fieldset>
                {%- endfor -%}
              </div>
            {%- endunless -%}

            <p class="stock" data-stock>
              {%- if current_variant.available -%}
                {%- if current_variant.inventory_management == 'shopify' and current_variant.inventory_policy == 'deny' and current_variant.inventory_quantity > 0 and current_variant.inventory_quantity <= low_stock_threshold -%}
                  <span class="stock__dot stock__dot--low"></span>{{ 'products.product.low_stock' | t: quantity: current_variant.inventory_quantity }}
                {%- else -%}
                  <span class="stock__dot"></span>{{ 'products.product.in_stock' | t }}
                {%- endif -%}
              {%- else -%}
                <span class="stock__dot stock__dot--out"></span>{{ 'products.product.out_of_stock' | t }}
              {%- endif -%}
            </p>

            <div class="buy">
              <div class="qty" data-qty>
                <button type="button" class="qty__btn" data-qty-minus aria-label="{{ 'products.product.quantity_decrease' | t }}">{% render 'icon', name: 'minus' %}</button>
                <label class="visually-hidden" for="Quantity-{{ section.id }}">{{ 'products.product.quantity' | t }}</label>
                <input class="qty__input" id="Quantity-{{ section.id }}" type="number" name="quantity" value="1" min="1" inputmode="numeric" data-qty-input>
                <button type="button" class="qty__btn" data-qty-plus aria-label="{{ 'products.product.quantity_increase' | t }}">{% render 'icon', name: 'plus' %}</button>
              </div>
              <button
                type="submit"
                name="add"
                class="btn btn--dark btn--block buy__add"
                data-add-button
                data-main-add
                {% unless current_variant.available %}disabled{% endunless %}
              >
                <span data-add-label>
                  {%- if current_variant.available -%}{{ 'products.product.add_to_cart' | t }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}
                </span>
                {% render 'icon', name: 'bag' %}
              </button>
            </div>
            {%- if section.settings.show_dynamic_checkout -%}
              <div class="buy__dynamic">{{ form | payment_button }}</div>
            {%- endif -%}
            <p class="form-message form-message--error" data-form-error hidden></p>
          {%- endform -%}

          {%- if section.settings.assurance != blank -%}
            <div class="assurance">
              {% render 'icon', name: 'lock' %}
              <div class="rte">{{ section.settings.assurance }}</div>
            </div>
          {%- endif -%}

          <div class="accordion">
            {%- if product.description != blank -%}
              <details class="accordion__item" open>
                <summary>{{ 'products.product.description' | t }}{% render 'icon', name: 'plus' %}</summary>
                <div class="accordion__content rte">{{ product.description }}</div>
              </details>
            {%- endif -%}
            {%- for block in section.blocks -%}
              {%- case block.type -%}
                {%- when 'collapsible' -%}
                  {%- if block.settings.content != blank or block.settings.page != blank -%}
                    <details class="accordion__item" {{ block.shopify_attributes }}>
                      <summary>{{ block.settings.heading | escape }}{% render 'icon', name: 'plus' %}</summary>
                      <div class="accordion__content rte">
                        {{ block.settings.content }}
                        {{ block.settings.page.content }}
                      </div>
                    </details>
                  {%- endif -%}
              {%- endcase -%}
            {%- endfor -%}
          </div>

          {%- if settings.whatsapp_number != blank -%}
            <a class="help-link" href="https://wa.me/{{ settings.whatsapp_number | remove: '+' | remove: ' ' }}?text={{ product.title | append: ' — ' | append: request.origin | append: product.url | url_encode }}" target="_blank" rel="noopener">
              {% render 'icon', name: 'whatsapp' %} {{ 'products.product.ask_whatsapp' | t }}
            </a>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>

  {%- comment -%} Mobil yapışkan sepete ekle {%- endcomment -%}
  <div class="sticky-buy" data-sticky-buy aria-hidden="true">
    <div class="sticky-buy__inner">
      {%- if product.featured_media -%}
        <img class="sticky-buy__img" src="{{ product.featured_media.preview_image | image_url: width: 120 }}" alt="" width="48" height="48" loading="lazy">
      {%- endif -%}
      <div class="sticky-buy__text">
        <span class="sticky-buy__title">{{ product.title | escape }}</span>
        <span class="sticky-buy__price" data-sticky-price>{{ current_variant.price | money }}</span>
      </div>
      <button type="submit" form="{{ form_id }}" name="add" class="btn btn--dark btn--sm" data-add-button data-sticky-add tabindex="-1" {% unless current_variant.available %}disabled{% endunless %}>
        <span data-add-label>{%- if current_variant.available -%}{{ 'products.product.add_to_cart' | t }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}</span>
      </button>
    </div>
  </div>

  {%- comment -%} Tam ekran görsel {%- endcomment -%}
  {%- if product.media.size > 0 -%}
    <div class="zoom" data-zoom hidden role="dialog" aria-modal="true" aria-label="{{ 'products.product.gallery' | t }}">
      <button type="button" class="zoom__close header__icon" data-zoom-close aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button>
      <ul class="zoom__track" data-zoom-track role="list">
        {%- for media in product.media -%}
          {%- if media.media_type == 'image' -%}
            <li><img data-src="{{ media.preview_image | image_url: width: 2000 }}" alt="{{ media.alt | escape }}" width="{{ media.preview_image.width }}" height="{{ media.preview_image.height }}"></li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}

  <script type="application/json" data-product-json>
    {
      "id": {{ product.id }},
      "url": {{ product.url | json }},
      "variants": [
        {%- for v in product.variants -%}
          {
            "id": {{ v.id }},
            "title": {{ v.title | json }},
            "options": {{ v.options | json }},
            "available": {{ v.available | json }},
            "price": {{ v.price | money | json }},
            "compare_at": {% if v.compare_at_price > v.price %}{{ v.compare_at_price | money | json }}{% else %}null{% endif %},
            "saving": {% if v.compare_at_price > v.price %}{{ v.compare_at_price | minus: v.price | times: 100.0 | divided_by: v.compare_at_price | round }}{% else %}0{% endif %},
            "media_id": {{ v.featured_media.id | default: 'null' }},
            "low": {% if v.inventory_management == 'shopify' and v.inventory_policy == 'deny' and v.inventory_quantity > 0 and v.inventory_quantity <= low_stock_threshold %}{{ v.inventory_quantity }}{% else %}0{% endif %}
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
</section>

{% render 'product-schema', product: product %}

{% schema %}
{
  "name": "Ürün sayfası",
  "class": "section-main-product",
  "settings": [
    { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Hızlı ödeme butonlarını göster (Hemen Al)", "default": true },
    { "type": "range", "id": "low_stock_threshold", "label": "\"Son X ürün\" uyarısı eşiği", "min": 0, "max": 10, "step": 1, "default": 3, "info": "Gerçek stok adedine göre gösterilir. 0 = kapalı." },
    { "type": "richtext", "id": "assurance", "label": "Güvence metni", "default": "<p><strong>Güvenli ödeme.</strong> Ödemeniz şifreli ve güvenli ödeme altyapısıyla alınır.</p>" }
  ],
  "blocks": [
    {
      "type": "collapsible",
      "name": "Açılır bilgi",
      "settings": [
        { "type": "text", "id": "heading", "label": "Başlık", "default": "Kargo ve İade" },
        { "type": "richtext", "id": "content", "label": "İçerik" },
        { "type": "page", "id": "page", "label": "Sayfa içeriği" }
      ]
    }
  ]
}
{% endschema %}
