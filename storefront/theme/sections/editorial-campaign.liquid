{%- liquid
  assign p = section.settings.product
  if p == blank
    for candidate in collections.all.products limit: 24
      if candidate.available and candidate.media.size > 1
        assign p = candidate
        break
      endif
    endfor
  endif

  assign main_index = section.settings.main_image_index | minus: 1
  assign inset_index = section.settings.inset_image_index | minus: 1
  assign main_image = section.settings.image | default: p.media[main_index].preview_image | default: p.featured_media.preview_image
  assign inset_image = section.settings.inset_image | default: p.media[inset_index].preview_image
  assign cta_url = p.url | default: routes.all_products_collection_url
-%}

<section class="editorial" aria-labelledby="EditorialTitle-{{ section.id }}">
  <div class="editorial__inner container">
    <div class="editorial__visual">
      <div class="editorial__main" data-parallax="0.08">
        {%- if main_image -%}
          {%- render 'responsive-image', image: main_image, widths: '480, 720, 960, 1200, 1500', sizes: '(min-width: 990px) 52vw, 92vw', class: 'editorial__img', alt: p.title -%}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg editorial__img' }}
        {%- endif -%}
      </div>
      {%- if inset_image -%}
        <div class="editorial__inset" data-parallax="-0.12" data-reveal>
          {%- render 'responsive-image', image: inset_image, widths: '300, 420, 600', sizes: '(min-width: 990px) 20vw, 40vw', class: 'editorial__img', alt: '' -%}
        </div>
      {%- endif -%}
      {%- if section.settings.caption != blank -%}
        <p class="editorial__caption" aria-hidden="true">{{ section.settings.caption | escape }}</p>
      {%- endif -%}
    </div>

    <div class="editorial__copy" data-reveal>
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2 class="editorial__title" id="EditorialTitle-{{ section.id }}">
        {{- section.settings.heading | escape -}}
        {%- if section.settings.heading_italic != blank -%}
          <em>{{ section.settings.heading_italic | escape }}</em>
        {%- endif -%}
      </h2>
      {%- if section.settings.text != blank -%}
        <div class="editorial__text rte">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if p != blank -%}
        <div class="editorial__product">
          <span class="editorial__product-name">{{ section.settings.display_title | default: p.title | escape }}</span>
          {% render 'price', product: p %}
        </div>
      {%- endif -%}
      <a class="btn btn--dark" href="{{ cta_url }}"><span>{{ section.settings.button_label | escape }}</span>{% render 'icon', name: 'arrow-right' %}</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Kampanya / Editoryal",
  "class": "section-editorial",
  "settings": [
    { "type": "product", "id": "product", "label": "Ürün" },
    { "type": "text", "id": "display_title", "label": "Görünen ürün adı" },
    { "type": "range", "id": "main_image_index", "label": "Ana görsel (ürün görsel sırası)", "min": 1, "max": 10, "step": 1, "default": 2 },
    { "type": "range", "id": "inset_image_index", "label": "Küçük görsel (ürün görsel sırası)", "min": 1, "max": 10, "step": 1, "default": 4 },
    { "type": "image_picker", "id": "image", "label": "Ana görsel yerine kampanya fotoğrafı" },
    { "type": "image_picker", "id": "inset_image", "label": "Küçük görsel yerine fotoğraf" },
    { "type": "text", "id": "eyebrow", "label": "Üst başlık", "default": "Kampanya · Sezonun parçası" },
    { "type": "text", "id": "heading", "label": "Başlık", "default": "Günden geceye" },
    { "type": "text", "id": "heading_italic", "label": "Başlık (italik devam)", "default": "tek çanta." },
    { "type": "richtext", "id": "text", "label": "Metin", "default": "<p>Yapılandırılmış form, dengeli ölçüler ve her kombine eşlik eden sade bir duruş.</p>" },
    { "type": "text", "id": "caption", "label": "Dikey küçük yazı", "default": "Trendçantanız — Editoryal" },
    { "type": "text", "id": "button_label", "label": "Buton", "default": "Ürünü İncele" }
  ],
  "presets": [{ "name": "Kampanya / Editoryal" }]
}
{% endschema %}
