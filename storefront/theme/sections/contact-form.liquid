<section class="section">
  <div class="container container--narrow">
    {%- if section.settings.heading != blank -%}<h2 class="section-title">{{ section.settings.heading | escape }}</h2>{%- endif -%}
    {%- form 'contact', id: 'ContactForm', class: 'form' -%}
      {%- if form.posted_successfully? -%}
        <p class="form-message form-message--ok" role="status">{% render 'icon', name: 'check' %} {{ 'contact.success' | t }}</p>
      {%- elsif form.errors -%}
        <div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <div class="form__row">
        <label class="field"><span>{{ 'contact.name' | t }}</span><input type="text" name="contact[{{ 'contact.name' | t }}]" autocomplete="name" value="{{ form.name }}"></label>
        <label class="field"><span>{{ 'customer.email' | t }} *</span><input type="email" name="contact[email]" autocomplete="email" required value="{{ form.email }}"></label>
      </div>
      <label class="field"><span>{{ 'contact.phone' | t }}</span><input type="tel" name="contact[{{ 'contact.phone' | t }}]" autocomplete="tel" value="{{ form.phone }}"></label>
      <label class="field"><span>{{ 'contact.message' | t }}</span><textarea rows="6" name="contact[body]">{{ form.body }}</textarea></label>
      <button type="submit" class="btn btn--dark">{{ 'contact.send' | t }}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "İletişim formu",
  "class": "section-contact",
  "settings": [ { "type": "text", "id": "heading", "label": "Başlık", "default": "Bize yazın" } ],
  "presets": [{ "name": "İletişim formu" }]
}
{% endschema %}
