{%- if section.settings.text != blank -%}
  <div class="announcement" role="region" aria-label="{{ 'sections.announcement.label' | t }}">
    {%- if section.settings.link != blank -%}
      <a class="announcement__inner" href="{{ section.settings.link }}">{{ section.settings.text | escape }}</a>
    {%- else -%}
      <p class="announcement__inner">{{ section.settings.text | escape }}</p>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Duyuru çubuğu",
  "class": "section-announcement",
  "enabled_on": { "groups": ["header"] },
  "settings": [
    { "type": "text", "id": "text", "label": "Metin", "default": "Güvenli ödeme · Kolay sipariş", "info": "Yalnızca mağazanızda gerçekten geçerli olan bilgileri yazın (ör. kargo süresi, ücretsiz kargo limiti)." },
    { "type": "url", "id": "link", "label": "Bağlantı" }
  ]
}
{% endschema %}
