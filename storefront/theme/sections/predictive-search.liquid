{%- if predictive_search.performed -%}
  <div class="predictive__inner" data-predictive-inner>
    {%- if predictive_search.resources.products.size > 0 -%}
      <p class="predictive__heading">{{ 'search.products' | t }}</p>
      <ul class="predictive__list" role="list">
        {%- for product in predictive_search.resources.products limit: 6 -%}
          <li>
            <a class="predictive__item" href="{{ product.url }}">
              {%- if product.featured_media -%}
                <img src="{{ product.featured_media.preview_image | image_url: width: 160 }}" alt="" width="64" height="64" loading="lazy">
              {%- endif -%}
              <span class="predictive__text">
                <span class="predictive__title">{{ product.title | escape }}</span>
                <span class="predictive__price">{{ product.price | money }}</span>
              </span>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
    {%- if predictive_search.resources.collections.size > 0 -%}
      <p class="predictive__heading">{{ 'search.collections' | t }}</p>
      <ul class="predictive__links" role="list">
        {%- for c in predictive_search.resources.collections limit: 4 -%}
          <li><a href="{{ c.url }}">{{ c.title | escape }}</a></li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
    {%- if predictive_search.resources.products.size == 0 and predictive_search.resources.collections.size == 0 -%}
      <p class="predictive__empty">{{ 'search.no_results' | t }}</p>
    {%- endif -%}
    <a class="link-arrow predictive__all" href="{{ routes.search_url }}?q={{ predictive_search.terms | url_encode }}&type=product">
      {{ 'search.view_all' | t: terms: predictive_search.terms }}{% render 'icon', name: 'arrow-right' %}
    </a>
  </div>
{%- endif -%}
