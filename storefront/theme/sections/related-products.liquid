<section
  class="section rail related"
  data-recommendations
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}&intent=related"
>
  {%- if recommendations.performed? and recommendations.products_count > 0 -%}
    <div class="container">
      <div class="section-head" data-reveal>
        <h2 class="section-title">{{ section.settings.heading | escape }}</h2>
        <a class="link-arrow" href="{{ routes.all_products_collection_url }}">{{ 'sections.tiles.all_bags' | t }}{% render 'icon', name: 'arrow-right' %}</a>
      </div>
    </div>
    <div class="rail__viewport" data-rail-viewport>
      <ul class="rail__list" data-count="{{ recommendations.products_count }}" role="list">
        {%- for rec in recommendations.products -%}
          <li class="rail__item">
            {% render 'product-card', product: rec, sizes: '(min-width: 1200px) 24vw, (min-width: 750px) 34vw, 74vw' %}
          </li>
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Benzer ürünler",
  "class": "section-related",
  "settings": [
    { "type": "text", "id": "heading", "label": "Başlık", "default": "Bunları da beğenebilirsin" },
    { "type": "range", "id": "limit", "label": "Ürün sayısı", "min": 2, "max": 8, "step": 1, "default": 4 }
  ]
}
{% endschema %}
