<section class="section account-form">
  <div class="container container--xs">
    <h1 class="page-title">{{ 'customer.register' | t }}</h1>
    {%- form 'create_customer', novalidate: 'novalidate', class: 'form' -%}
      {%- if form.errors -%}<div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="form__row">
        <label class="field"><span>{{ 'customer.first_name' | t }}</span><input type="text" name="customer[first_name]" autocomplete="given-name"></label>
        <label class="field"><span>{{ 'customer.last_name' | t }}</span><input type="text" name="customer[last_name]" autocomplete="family-name"></label>
      </div>
      <label class="field"><span>{{ 'customer.email' | t }}</span><input type="email" name="customer[email]" autocomplete="email" autocapitalize="off" required></label>
      <label class="field"><span>{{ 'customer.password' | t }}</span><input type="password" name="customer[password]" autocomplete="new-password" required></label>
      <button type="submit" class="btn btn--dark btn--block">{{ 'customer.create' | t }}</button>
      <p class="form__alt"><a href="{{ routes.account_login_url }}">{{ 'customer.log_in' | t }}</a></p>
    {%- endform -%}
  </div>
</section>
