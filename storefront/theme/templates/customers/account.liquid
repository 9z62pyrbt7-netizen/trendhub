<section class="section account">
  <div class="container">
    <div class="page-head">
      <h1 class="page-title">{{ 'customer.account' | t }}</h1>
      <a class="link-arrow" href="{{ routes.account_logout_url }}">{{ 'customer.log_out' | t }}</a>
    </div>
    <div class="account__grid">
      <div>
        <h2 class="section-title section-title--sm">{{ 'customer.orders' | t }}</h2>
        {%- paginate customer.orders by 20 -%}
          {%- if customer.orders.size > 0 -%}
            <table class="table">
              <thead><tr><th>{{ 'customer.order' | t }}</th><th>{{ 'customer.date' | t }}</th><th>{{ 'customer.payment' | t }}</th><th>{{ 'customer.fulfillment' | t }}</th><th>{{ 'cart.subtotal' | t }}</th></tr></thead>
              <tbody>
                {%- for order in customer.orders -%}
                  <tr>
                    <td><a href="{{ order.customer_url }}">{{ order.name }}</a></td>
                    <td>{{ order.created_at | time_tag: format: 'date' }}</td>
                    <td>{{ order.financial_status_label }}</td>
                    <td>{{ order.fulfillment_status_label }}</td>
                    <td>{{ order.total_net_amount | money }}</td>
                  </tr>
                {%- endfor -%}
              </tbody>
            </table>
          {%- else -%}
            <p>{{ 'customer.no_orders' | t }}</p>
          {%- endif -%}
          {% render 'pagination', paginate: paginate %}
        {%- endpaginate -%}
      </div>
      <aside>
        <h2 class="section-title section-title--sm">{{ 'customer.details' | t }}</h2>
        <p>{{ customer.name }}<br>{{ customer.email }}</p>
        {{ customer.default_address | format_address }}
        <a class="link-arrow" href="{{ routes.account_addresses_url }}">{{ 'customer.addresses' | t }} ({{ customer.addresses_count }}){% render 'icon', name: 'arrow-right' %}</a>
      </aside>
    </div>
  </div>
</section>
