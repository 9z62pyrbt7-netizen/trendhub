<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="theme-color" content="{{ settings.color_background }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ 'general.meta.tags' | t: tags: current_tags }}{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {% render 'meta-tags' %}

    {%- # theme-check-disable AssetPreload -%}
    {%- unless settings.font_heading.system? -%}
      <link rel="preload" as="font" href="{{ settings.font_heading | font_url }}" type="font/woff2" crossorigin>
    {%- endunless -%}
    {%- unless settings.font_body.system? -%}
      <link rel="preload" as="font" href="{{ settings.font_body | font_url }}" type="font/woff2" crossorigin>
    {%- endunless -%}
    {%- # theme-check-enable AssetPreload -%}

    <script>document.documentElement.className = document.documentElement.className.replace('no-js', 'js');</script>

    {%- liquid
      assign font_body_bold = settings.font_body | font_modify: 'weight', '500'
      assign font_heading_italic = settings.font_heading | font_modify: 'style', 'italic'
    -%}
    {% style %}
      {{ settings.font_heading | font_face: font_display: 'swap' }}
      {{ font_heading_italic | font_face: font_display: 'swap' }}
      {{ settings.font_body | font_face: font_display: 'swap' }}
      {{ font_body_bold | font_face: font_display: 'swap' }}

      :root {
        --c-bg: {{ settings.color_background }};
        --c-surface: {{ settings.color_surface }};
        --c-sand: {{ settings.color_sand }};
        --c-text: {{ settings.color_text }};
        --c-muted: {{ settings.color_muted }};
        --c-accent: {{ settings.color_accent }};
        --c-text-rgb: {{ settings.color_text.red }}, {{ settings.color_text.green }}, {{ settings.color_text.blue }};
        --c-bg-rgb: {{ settings.color_background.red }}, {{ settings.color_background.green }}, {{ settings.color_background.blue }};
        --font-heading: {{ settings.font_heading.family }}, {{ settings.font_heading.fallback_families }};
        --font-heading-weight: {{ settings.font_heading.weight }};
        --font-body: {{ settings.font_body.family }}, {{ settings.font_body.fallback_families }};
        --font-body-weight: {{ settings.font_body.weight }};
        --font-body-weight-bold: {{ font_body_bold.weight | default: 500 }};
        --heading-scale: {{ settings.heading_scale | divided_by: 100.0 }};
      }
    {% endstyle %}

    {{ 'theme.css' | asset_url | stylesheet_tag: preload: true }}

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name | handleize }}{% if template.suffix %} template-{{ template.suffix | handleize }}{% endif %}{% unless settings.enable_motion %} no-motion{% endunless %}">
    <a class="skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" class="main" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {%- if settings.cart_type == 'drawer' and template.name != 'cart' -%}
      {% section 'cart-drawer' %}
    {%- endif -%}

    <div class="toast" data-toast role="status" aria-live="polite" hidden></div>

    {% render 'organization-schema' %}

    <script>
      window.theme = {
        routes: {
          root: {{ routes.root_url | json }},
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | json }},
          cartChange: {{ routes.cart_change_url | json }},
          cartUpdate: {{ routes.cart_update_url | json }},
          search: {{ routes.search_url | json }},
          predictiveSearch: {{ routes.predictive_search_url | json }}
        },
        cartType: {{ settings.cart_type | json }},
        moneyFormat: {{ shop.money_format | json }},
        motion: {{ settings.enable_motion | json }},
        strings: {
          addToCart: {{ 'products.product.add_to_cart' | t | json }},
          soldOut: {{ 'products.product.sold_out' | t | json }},
          unavailable: {{ 'products.product.unavailable' | t | json }},
          added: {{ 'cart.added' | t | json }},
          error: {{ 'cart.error' | t | json }},
          inStock: {{ 'products.product.in_stock' | t | json }},
          lowStock: {{ 'products.product.low_stock' | t: quantity: '__COUNT__' | json }},
          outOfStock: {{ 'products.product.out_of_stock' | t | json }},
          cartCount: {{ 'sections.header.cart_count' | t: count: 2 | replace: '2', '__COUNT__' | json }}
        }
      };
    </script>
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
  </body>
</html>
